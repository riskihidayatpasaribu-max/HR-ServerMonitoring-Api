        }
        finally
        {
            isRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static int GaugeWidth(double? value, double? min, double? max)
    {
        if (!value.HasValue || !min.HasValue || !max.HasValue || max <= min)
            return 0;

        var percentage = (value.Value - min.Value) / (max.Value - min.Value) * 100.0;
        return Math.Clamp((int)Math.Round(percentage), 3, 100);
    }

    private string? selectedDeviceId;
    private List<DeviceEventRow> selectedDeviceEvents = new();
    private bool isDeviceLogOpen;
    private bool isLoadingDeviceLogs;

    private async Task OpenDeviceLogs(string deviceId)
    {
        selectedDeviceId = deviceId;
        isDeviceLogOpen = true;
        isLoadingDeviceLogs = true;
        selectedDeviceEvents.Clear();

        try
        {
            var events = await Http.GetFromJsonAsync<List<DeviceEventRow>>(
                "http://localhost:5186/api/DeviceEvents");

            selectedDeviceEvents = events?
                .Where(x => x.DeviceId == deviceId)
                .OrderByDescending(x => x.Timestamp)
                .Take(100)
                .ToList() ?? new List<DeviceEventRow>();
        }
        catch
        {
            selectedDeviceEvents = new List<DeviceEventRow>();
        }
        finally
        {
            isLoadingDeviceLogs = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseDeviceLogs()
    {
        isDeviceLogOpen = false;
        selectedDeviceId = null;
        selectedDeviceEvents.Clear();
    }

