t-time{font-size:10px;color:#929aaa;padding-top:2px}.event-marker{width:8px;height:8px;border-radius:50%;margin-top:5px;background:#7c88e8}.event-marker.connection{background:#27a979}.event-marker.threshold{background:#e19a45}.event-marker.threshold_update{background:#7181e7}.event-marker.level_change{background:#d56868}.event-title{font-size:10px;font-weight:850;letter-spacing:.1em;color:#657083}.event-message{font-size:12px;color:#343e50;margin-top:5px;line-height:1.5}.event-level{display:inline-block;margin-top:7px;padding:4px 7px;background:#f2f4f8;border-radius:5px;font-size:9px;color:#758093}.empty-log{padding:55px 20px;text-align:center;color:#8892a2}.empty-log span{display:block;font-size:28px;margin-bottom:10px}.empty-log b{display:block;color:#4f5a6d;font-size:13px}.empty-log small{display:block;margin-top:4px;font-size:11px}@@media(max-width:1050px){.metrics-grid{grid-template-columns:repeat(2,1fr)}.node-row{grid-template-columns:1fr}.sensor-detail-grid{grid-template-columns:repeat(3,1fr)}}@@media(max-width:700px){.dashboard-shell{padding:18px 12px 40px}.topbar{align-items:flex-start;flex-direction:column}.top-actions{width:100%;justify-content:space-between}.metrics-grid{grid-template-columns:1fr}.node-row{padding:17px}.sensor-detail-grid{grid-template-columns:1fr;gap:18px}.threshold-line{grid-template-columns:1fr}.threshold-actions{align-items:stretch;flex-direction:column}.save-button{width:100%}.event-row{grid-template-columns:1fr 10px 2fr}.event-time{grid-column:1/-1}.threshold-panel{padding:19px}}
</style>

@code
{
    
    private List<SensorData>? sensorData;

    private readonly Dictionary<string, MqttTelemetry> liveTelemetry = new();

    private DotNetObjectReference<Dashboard>? dotNetReference;

    private SensorThreshold? threshold;
    private string? thresholdMessage;

    private sealed class ThresholdUpdateResponse
    {
        public SensorThreshold? Threshold { get; set; }
        public bool Esp32CommandSent { get; set; }
    }

    private async Task SaveThreshold()
    {
        thresholdMessage = null;

        if (threshold == null)
            return;

        if (threshold.TemperatureMin >= threshold.TemperatureMax)
        {
            thresholdMessage =
                "Temperature minimum harus lebih kecil dari maximum.";
            return;
        }

        if (threshold.HumidityMin >= threshold.HumidityMax)
        {
            thresholdMessage =
                "Humidity minimum harus lebih kecil dari maximum.";
            return;
        }

        if (threshold.GasLevelMin >= threshold.GasLevelMax)
        {
            thresholdMessage =
                "Gas level minimum harus lebih kecil dari maximum.";
            return;
        }

        var response = await Http.PutAsJsonAsync(
            "http://localhost:5186/api/Threshold",
            threshold);

        if (response.IsSuccessStatusCode)
        {
            foreach (var telemetry in liveTelemetry.Values)
            {
                ApplyThreshold(telemetry);
            }

            var result = await response.Content
                .ReadFromJsonAsync<ThresholdUpdateResponse>();

            thresholdMessage = result?.Esp32CommandSent == true
                ? "Threshold berhasil disimpan dan dikirim ke ESP32."
                : "Threshold berhasil disimpan, tetapi ESP32 belum terhubung sehingga command belum terkirim.";

            await InvokeAsync(StateHasChanged);
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            thresholdMessage = string.IsNullOrWhiteSpace(error)
                ? "Gagal menyimpan threshold."
                : $"Gagal menyimpan threshold: {error}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        sensorData = await Http.GetFromJsonAsync<List<SensorData>>(
            "http://localhost:5186/api/SensorData");


        threshold = await Http.GetFromJsonAsync<SensorThreshold>(
            "http://localhost:5186/api/Threshold");

        devices = await Http.GetFromJsonAsync<List<DeviceStatus>>(
            "http://localhost:5186/api/Device");
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "sensorSignalR.start",
                dotNetReference);
        }
    }

    [JSInvokable]
    public async Task ReceiveSensorData(SensorData data)
    {
        Console.WriteLine(
            $"BLAZOR RECEIVED: {data.DeviceId} | " +
            $"{data.Temperature} | " +
            $"{data.Humidity} | " +
            $"{data.GasLevel}");

        sensorData ??= new List<SensorData>();

        sensorData.Add(data);

        // Update daftar device
        devices = await Http.GetFromJsonAsync<List<DeviceStatus>>(
            "http://localhost:5186/api/Device");

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ReceiveMqttTelemetry(MqttTelemetry data)
    {
        Console.WriteLine(
            $"MQTT BLAZOR RECEIVED: {data.DeviceId} | " +
            $"{data.Temperature} | " +
            $"{data.Humidity} | " +
            $"{data.GasPercent}");

        if (string.IsNullOrEmpty(data.DeviceId))
            return;

        ApplyThreshold(data);

        liveTelemetry[data.DeviceId] = data;

        // Pastikan device ada
        devices ??= new List<DeviceStatus>();

        var device = devices.FirstOrDefault(
            x => x.DeviceId == data.DeviceId);

        if (device == null)
        {
            device = new DeviceStatus
            {
                DeviceId = data.DeviceId,
                Status = "ONLINE",
                LastSeen = DateTime.UtcNow
            };

            devices.Add(device);
        }
        else
        {
            device.Status = "ONLINE";
            device.LastSeen = DateTime.UtcNow;
        }

        // Simpan ke sensorData agar card atas juga berubah
        if (data.Temperature.HasValue &&
            data.Humidity.HasValue &&
            data.GasPercent.HasValue)
        {
            sensorData ??= new List<SensorData>();

            sensorData.Add(new SensorData
            {
                DeviceId = data.DeviceId,
                Temperature = data.Temperature.Value,
                Humidity = data.Humidity.Value,
                GasLevel = data.GasPercent.Value,
                Timestamp = data.ReceivedAt
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ApplyThreshold(MqttTelemetry data)
    {
        if (threshold == null)
            return;

        data.TemperatureInRange =
            !data.Temperature.HasValue ||
            (data.Temperature.Value >= threshold.TemperatureMin &&
             data.Temperature.Value <= threshold.TemperatureMax);

        data.HumidityInRange =
            !data.Humidity.HasValue ||
            (data.Humidity.Value >= threshold.HumidityMin &&
             data.Humidity.Value <= threshold.HumidityMax);

        data.GasInRange =
            !data.GasPercent.HasValue ||
            (data.GasPercent.Value >= threshold.GasLevelMin &&
             data.GasPercent.Value <= threshold.GasLevelMax);

        // OVERALL sekarang mengikuti threshold yang diatur user melalui web.
        data.OverallLevel =
            data.OverallInRange
                ? "ok"
                : "alarm";
    }

    public class MqttTelemetry
    {
        public bool TemperatureInRange { get; set; }
        public bool HumidityInRange { get; set; }
        public bool GasInRange { get; set; }

        public bool OverallInRange =>
            TemperatureInRange &&
            HumidityInRange &&
            GasInRange;
        public string? DeviceId { get; set; }
        public string? Location { get; set; }
        public string? Firmware { get; set; }

        public long UptimeS { get; set; }
        public long AgeMs { get; set; }

        public double? Temperature { get; set; }
        public double? Humidity { get; set; }

        public int? GasRaw { get; set; }
        public double? GasPercent { get; set; }

        public string? TemperatureLevel { get; set; }
        public string? HumidityLevel { get; set; }
        public string? GasLevel { get; set; }
        public string? OverallLevel { get; set; }

        public int Rssi { get; set; }

        public DateTime ReceivedAt { get; set; }
    }

    [JSInvokable]
    public async Task ReceiveDeviceStatus(DeviceStatusMessage data)
    {
        Console.WriteLine(
            $"MQTT STATUS BLAZOR RECEIVED: {data.DeviceId} | {data.Status}");

        devices ??= new List<DeviceStatus>();

        var device = devices.FirstOrDefault(
            x => x.DeviceId == data.DeviceId);

        if (device == null)
        {
            device = new DeviceStatus
            {
                DeviceId = data.DeviceId
            };

            devices.Add(device);
        }

        device.Status = data.Status.ToUpperInvariant();
        device.LastSeen = DateTime.UtcNow;

        await InvokeAsync(StateHasChanged);
    }

    private static string GetLevelCss(string? level)
    {
        return level?.ToLowerInvariant() switch
        {
            "ok" => "safe",
            "warning" => "warning",
            "alarm" => "unsafe",
            _ => ""
        };
    }

