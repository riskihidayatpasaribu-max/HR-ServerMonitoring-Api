@page "/dashboard"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

@using System.Net.Http.Json
@using Microsoft.JSInterop
@using HR.ServerMonitoring.Api.Models

@inject HttpClient Http
@inject IJSRuntime JS

@implements IAsyncDisposable

<div class="dashboard-shell">
    <div class="dashboard-container">
        <header class="topbar">
            <div>
                <div class="eyebrow"><span class="eyebrow-dot"></span> SERVER INFRASTRUCTURE</div>
                <h1>Server Monitoring</h1>
                <p>Real-time telemetry and diagnostics</p>
            </div>
            <div class="top-actions">
                <div class="live-pill">
                    <span class="live-dot"></span>
                    <span>System Live</span>
                </div>
                <button class="sync-button" @onclick="async () => await RefreshDashboard()" disabled="@isRefreshing">
                    <span class="sync-icon @(isRefreshing ? "spin" : "")">↻</span>
                    Sync
                </button>
            </div>
        </header>

        @if (sensorData == null)
        {
            <div class="state-panel">Mengambil data monitoring...</div>
        }
        else
        {
            var latest = sensorData.OrderByDescending(x => x.Timestamp).FirstOrDefault();
            var deviceCount = devices?.Count ?? sensorData.Select(x => x.DeviceId).Distinct().Count();
            var onlineCount = devices?.Count(x => x.Status == "ONLINE") ?? 0;

            <section class="metrics-grid">
                <div class="metric-card neutral">
                    <div class="metric-head"><span class="metric-icon">◈</span><span>TOTAL DATA</span></div>
                    <div class="metric-value">@sensorData.Count</div>
                    <div class="metric-caption">Sensor readings</div>
                </div>
                <div class="metric-card purple">
                    <div class="metric-head"><span class="metric-icon">▣</span><span>DEVICES</span></div>
                    <div class="metric-value">@deviceCount</div>
                    <div class="metric-caption">@onlineCount active now</div>
                    <div class="metric-bars">
                        @for (var i = 0; i < Math.Max(deviceCount, 1); i++)
                        {
                            <span class="@(i < onlineCount ? "bar-active" : "bar-idle")"></span>
                        }
                    </div>
                </div>
                <div class="metric-card temp">
                    <div class="metric-head"><span class="metric-icon">♨</span><span>TEMPERATURE</span></div>
                    <div class="metric-value">@(latest?.Temperature.ToString("0.0") ?? "-") <small>°C</small></div>
                    <div class="metric-caption">@(latest?.DeviceId ?? "No data")</div>
                </div>
                <div class="metric-card humidity">
                    <div class="metric-head"><span class="metric-icon">◌</span><span>HUMIDITY</span></div>
                    <div class="metric-value">@(latest?.Humidity.ToString("0.0") ?? "-") <small>%</small></div>
                    <div class="metric-caption">@(latest?.DeviceId ?? "No data")</div>
                </div>
                <div class="metric-card gas">
                    <div class="metric-head"><span class="metric-icon">≋</span><span>GAS LEVEL</span></div>
                    <div class="metric-value">@(latest?.GasLevel.ToString("0.0") ?? "-")</div>
                    <div class="metric-caption">@(latest?.DeviceId ?? "No data")</div>
                </div>
            </section>

            <section class="section-block">
                <div class="section-title-row">
                    <div>
                        <div class="section-kicker">DEVICE MONITORING</div>
                        <h2>Node Details</h2>
                    </div>
                    <span class="node-count">@deviceCount node(s)</span>
                </div>

                <div class="node-panel">
                    @if (devices == null || devices.Count == 0)
                    {
                        <div class="state-panel compact">Belum ada device.</div>
                    }
                    else
                    {
                        @foreach (var device in devices)
                        {
                            var telemetry = liveTelemetry.GetValueOrDefault(device.DeviceId);
                            var overallSafe = telemetry?.OverallInRange ?? true;
                            var online = device.Status == "ONLINE";

                            <button class="node-row" @onclick="() => OpenDeviceLogs(device.DeviceId)">
                                <div class="node-identity">
                                    <div class="node-status @(online ? "online" : "offline")">
                                        <span></span>@device.Status
                                    </div>
                                    <div class="node-name">@device.DeviceId</div>
                                    <div class="node-location">@(telemetry?.Location ?? "Server monitoring node")</div>
                                    <div class="node-health @(overallSafe ? "health-ok" : "health-alarm")">
                                        <span>@(overallSafe ? "✓" : "!")</span>
                                        @(overallSafe ? "All systems operational" : "Monitoring alert active")
                                    </div>
                                </div>

                                <div class="sensor-detail-grid">
                                    <div class="sensor-detail">
                                        <div class="sensor-detail-head"><span>Temperature</span><b class="@(telemetry?.TemperatureInRange == false ? "danger" : "ok")">@(telemetry?.TemperatureInRange == false ? "ALARM" : "OK")</b></div>
                                        <div class="sensor-number">@(telemetry?.Temperature?.ToString("0.0") ?? "-") <small>°C</small></div>
                                        <div class="gauge"><span class="gauge-fill temp-fill" style="width:@GaugeWidth(telemetry?.Temperature, threshold?.TemperatureMin, threshold?.TemperatureMax)%"></span></div>
                                        <div class="range"><span>Min: @(threshold?.TemperatureMin.ToString("0.0") ?? "-")°C</span><span>Max: @(threshold?.TemperatureMax.ToString("0.0") ?? "-")°C</span></div>
                                    </div>
                                    <div class="sensor-detail">
                                        <div class="sensor-detail-head"><span>Humidity</span><b class="@(telemetry?.HumidityInRange == false ? "danger" : "ok")">@(telemetry?.HumidityInRange == false ? "ALARM" : "OK")</b></div>
                                        <div class="sensor-number">@(telemetry?.Humidity?.ToString("0.0") ?? "-") <small>%</small></div>
                                        <div class="gauge"><span class="gauge-fill humidity-fill" style="width:@GaugeWidth(telemetry?.Humidity, threshold?.HumidityMin, threshold?.HumidityMax)%"></span></div>
                                        <div class="range"><span>Min: @(threshold?.HumidityMin.ToString("0.0") ?? "-")%</span><span>Max: @(threshold?.HumidityMax.ToString("0.0") ?? "-")%</span></div>
                                    </div>
                                    <div class="sensor-detail">
                                        <div class="sensor-detail-head"><span>Gas Level</span><b class="@(telemetry?.GasInRange == false ? "danger" : "ok")">@(telemetry?.GasInRange == false ? "ALARM" : "OK")</b></div>
                                        <div class="sensor-number">@(telemetry?.GasPercent?.ToString("0.0") ?? "-") <small>%</small></div>
                                        <div class="gauge"><span class="gauge-fill gas-fill" style="width:@GaugeWidth(telemetry?.GasPercent, threshold?.GasLevelMin, threshold?.GasLevelMax)%"></span></div>
                                        <div class="range"><span>Min: @(threshold?.GasLevelMin.ToString("0.0") ?? "-")</span><span>Max: @(threshold?.GasLevelMax.ToString("0.0") ?? "-")</span></div>
                                    </div>
                                </div>
                                <div class="node-chevron">›</div>
                            </button>
                        }
                    }
                </div>
                <div class="node-hint">Click a device to view its event history.</div>
            </section>

            <section class="threshold-panel">
                <div class="threshold-header">
                    <div>
                        <div class="section-kicker">CONFIGURATION</div>
                        <h2>Alert Thresholds</h2>
                        <p>Configure safe operating ranges for monitoring alerts.</p>
                    </div>
                    <div class="settings-mark">⚙</div>
                </div>

                @if (threshold == null)
                {
                    <div class="state-panel compact">Mengambil konfigurasi threshold...</div>
                }
                else
                {
                    <div class="threshold-list">
                        <div class="threshold-line">
                            <div class="threshold-label"><span class="dot temp-dot"></span><div><b>Temperature</b><small>Operating range</small></div></div>
                            <div class="threshold-input"><label>MINIMUM</label><div><input type="number" step="0.1" @bind="threshold.TemperatureMin" /><span>°C</span></div></div>
                            <div class="threshold-input"><label>MAXIMUM</label><div><input type="number" step="0.1" @bind="threshold.TemperatureMax" /><span>°C</span></div></div>
                        </div>
                        <div class="threshold-line">
                            <div class="threshold-label"><span class="dot humidity-dot"></span><div><b>Humidity</b><small>Relative humidity</small></div></div>
                            <div class="threshold-input"><label>MINIMUM</label><div><input type="number" step="0.1" @bind="threshold.HumidityMin" /><span>%</span></div></div>
                            <div class="threshold-input"><label>MAXIMUM</label><div><input type="number" step="0.1" @bind="threshold.HumidityMax" /><span>%</span></div></div>
                        </div>
                        <div class="threshold-line">
                            <div class="threshold-label"><span class="dot gas-dot"></span><div><b>Gas Level</b><small>Gas concentration</small></div></div>
                            <div class="threshold-input"><label>MINIMUM</label><div><input type="number" step="0.1" @bind="threshold.GasLevelMin" /></div></div>
                            <div class="threshold-input"><label>MAXIMUM</label><div><input type="number" step="0.1" @bind="threshold.GasLevelMax" /></div></div>
                        </div>
                    </div>
                    <div class="threshold-actions">
                        <div class="threshold-notice">⚠ Changes affect monitoring alerts and are sent to the device through MQTT.</div>
                        <button class="save-button" @onclick="SaveThreshold">Save Configuration</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(thresholdMessage))
                    {
                        <div class="threshold-message @(thresholdMessage.Contains("berhasil", StringComparison.OrdinalIgnoreCase) ? "message-ok" : "message-error")">@thresholdMessage</div>
                    }
                }
            </section>
        }
    </div>
</div>

@if (isDeviceLogOpen)
{
    <div class="modal-backdrop" @onclick="CloseDeviceLogs">
        <div class="log-modal" @onclick:stopPropagation="true">
            <div class="log-modal-header">
                <div><div class="section-kicker">DEVICE EVENT HISTORY</div><h2>@selectedDeviceId</h2></div>
                <button class="close-button" @onclick="CloseDeviceLogs">×</button>
            </div>
            @if (isLoadingDeviceLogs)
            {
                <div class="state-panel compact">Mengambil event...</div>
            }
            else if (selectedDeviceEvents.Count == 0)
            {
                <div class="empty-log"><span>◌</span><b>No events recorded</b><small>Belum ada event untuk device ini.</small></div>
            }
            else
            {
                <div class="event-list">
                    @foreach (var ev in selectedDeviceEvents)
                    {
                        <div class="event-row">
                            <div class="event-time">@ev.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</div>
                            <div class="event-marker @(ev.EventType.ToLowerInvariant())"></div>
                            <div class="event-content"><div class="event-title">@ev.EventType.Replace("_", " ").ToUpperInvariant()</div><div class="event-message">@(ev.Message ?? "-")</div>@if (!string.IsNullOrWhiteSpace(ev.FromLevel) || !string.IsNullOrWhiteSpace(ev.ToLevel)){<div class="event-level">@(ev.FromLevel ?? "-") → @(ev.ToLevel ?? "-")</div>}</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

